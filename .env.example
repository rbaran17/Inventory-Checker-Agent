# Claude API key (https://platform.claude.com -> API Keys). Without it the app runs but cannot detect objects.
ANTHROPIC_API_KEY=
# Model and cost settings (defaults shown)
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_EFFORT=low
# CLAUDE_MAX_TOKENS=4000

# Address the phone opens, e.g. your cloudflared tunnel URL
PUBLIC_BASE_URL=https://<random-words>.trycloudflare.com
# Optional fixed access key (otherwise one is created on first start, saved in ~/.config/inventory-checker/access_key
# and reused after restarts)
# APP_ACCESS_KEY=
