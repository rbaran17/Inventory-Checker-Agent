# --- AI assist (Microsoft Agent Framework chat client) ---------------------------------
# AI_PROVIDER: claude | claude-foundry | azure | openai | none. Unset = first one configured below.
# AI_PROVIDER=claude

# Claude (Claude API). Get a key at https://platform.claude.com
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_TOKENS=16000

# Claude on Microsoft Foundry (in the firm's Azure tenant)
# ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_API_KEY=

# Recommended: Azure OpenAI in the firm's approved tenant. Without an API key the service
# signs in with DefaultAzureCredential (install the [azure] extra).
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# Local development only:
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Service ------------------------------------------------------------------------------
PUBLIC_BASE_URL=https://observe.firm.example
INVENTORY_DATA_DIR=data
# dev = trust X-User header / cookie sign-in. Anything else = only the TRUSTED_USER_HEADER set
# by the firm's SSO reverse proxy is accepted.
AUTH_MODE=dev
TRUSTED_USER_HEADER=X-User
EVIDENCE_RETENTION_YEARS=7

# --- Audit knowledge (methodology grounding) -------------------------------------------
# auto (default): skills/audit-knowledge/ once the real skill is added, else the bundled stand-in
# Other values: standin | dir:/path/to/audit-knowledge-skill | http:https://host/search | none
AUDIT_KNOWLEDGE_SOURCE=auto
# AUDIT_KNOWLEDGE_DIR=skills/audit-knowledge
# AUDIT_KNOWLEDGE_TOKEN=
