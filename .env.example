# Copy to .env and fill in. Docker Compose reads it automatically; for a local run, `set -a; source .env; set +a`.

# ---------------------------------------------------------------- AI provider (one of these)
# Leave AI_PROVIDER empty to use the first one configured below, in this order.
# AI_PROVIDER=anthropic            # anthropic | azure_openai | openai | none

# Anthropic Claude (https://platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_EFFORT=low                 # low | medium | high | xhigh | max

# Azure OpenAI - a vision-capable chat deployment
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_KEY=             # omit to sign in with Entra ID (needs the [azure] extra; included in the image)
# AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI - a vision-capable chat model
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Output cap per scan, any provider
# AI_MAX_TOKENS=4000

# Your own detector instead of a hosted model: an async function (frames, sample) -> SceneResult
# DETECTOR=my_package.my_module:detect

# ---------------------------------------------------------------- service
# Address the phone opens. Leave empty with Docker Compose: it is read from the tunnel container.
# PUBLIC_BASE_URL=https://<random-words>.trycloudflare.com
# Fixed access key (otherwise generated once and saved in ~/.config/inventory-checker/access_key, or /data in Docker)
# APP_ACCESS_KEY=
# Load an items to be tested listing (CSV or .xlsx) into the Engagement tab at startup
# SAMPLE_FILE=/path/to/items_to_be_tested.csv
# APP_PORT=8000                     # Docker Compose: laptop port
